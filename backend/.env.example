# --- Speech-to-Text (STT) ---
# Get yours at: https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# --- Translation (LLM) ---
# Get yours at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# --- System Settings ---
# Spoken language name used in translation prompt (e.g., English, Turkish)
SPOKEN_LANGUAGE=English
# Target language name used in translation prompt (e.g., Turkish, English)
TARGET_LANGUAGE=Turkish

# --- Linux Audio Device (optional) ---
# Substring matched against `arecord -L` / `pactl list sources short` device names.
# Common values: "pulse" (PulseAudio default sink monitor), "default", or a full ALSA name.
# If unset, auto-detection tries: monitor → pulse → default → system default input.
# LIVE_TRANSLATE_CHOSEN_DEVICE=pulse